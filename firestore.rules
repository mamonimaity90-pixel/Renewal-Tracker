rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic authentication helper
    function isSignedIn() {
      return request.auth != null;
    }

    // Role check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "mamoni.maity90@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    // Approval check
    function isApproved() {
      return isSignedIn() && (
        request.auth.token.email == "mamoni.maity90@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved"
      );
    }

    // Collection Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId && 
          (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
          (!('status' in resource.data) || request.resource.data.status == resource.data.status)
        )
      );
      allow delete: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read, write: if isApproved();
    }

    match /interactions/{interactionId} {
      allow read, write: if isApproved();
    }

    match /applications/{applicationId} {
      allow read, write: if isApproved();
    }

    match /report_schedules/{scheduleId} {
      allow read, write: if isApproved();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /zones/{zoneId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
