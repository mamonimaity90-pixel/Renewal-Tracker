{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "team"] },
        "zoneId": { "type": "string", "description": "ID of the zone this user belongs to" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "default": "pending" }
      },
      "required": ["uid", "name", "email", "role", "status"]
    },
    "Zone": {
      "title": "Zone",
      "description": "Regional zones like North, South, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "states": { "type": "array", "items": { "type": "string" } },
        "color": { "type": "string" },
        "totalPoints": { "type": "number" }
      },
      "required": ["name"]
    },
    "Hospital": {
      "title": "Hospital",
      "description": "Healthcare facility details for compliance tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "pincode": { "type": "string" },
        "beds": { "type": "number" },
        "applicationNo": { "type": "string" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "reapplied": { "type": "boolean" },
        "reappliedProgram": { "type": "string" },
        "renewalApplicationNo": { "type": "string" },
        "renewalApplicationDate": { "type": "string", "format": "date-time" },
        "assignedTo": { "type": "string" },
        "currentProgram": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Expired", "Pending Renewal"] },
        "contactPerson": { "type": "string" },
        "contactNumber": { "type": "string" },
        "alternateNumber": { "type": "string" },
        "designation": { "type": "string" },
        "nextFollowUpDate": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "status"]
    },
    "Interaction": {
      "title": "Interaction",
      "description": "Logged interaction with a hospital officer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hospitalId": { "type": "string" },
        "hospitalName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["Call", "Email", "Meeting"] },
        "result": { "type": "string", "enum": ["Connected", "Not Connected"] },
        "reason": { "type": "string" },
        "remarks": { "type": "string" },
        "adminChangeRemarks": { "type": "string" },
        "reapplied": { "type": "boolean" },
        "reapplicationProgram": { "type": "string" },
        "reapplicationNumber": { "type": "string" },
        "reapplicationDate": { "type": "string", "format": "date" },
        "verificationStatus": { "type": "string", "enum": ["Pending", "Verified", "Rejected"] },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "verifiedBy": { "type": "string" },
        "followUpDate": { "type": "string", "format": "date-time" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["hospitalId", "userId", "type", "timestamp"]
    },
    "Application": {
      "title": "Application",
      "description": "NABH application tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hospitalId": { "type": "string" },
        "hospitalName": { "type": "string" },
        "type": { "type": "string" },
        "applicationNo": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["hospitalId", "type", "applicationNo", "date"]
    },
    "ReportSchedule": {
      "title": "Report Schedule",
      "description": "Automated report configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
        "recipients": { "type": "string" },
        "type": { "type": "string", "enum": ["summary", "detailed"] },
        "createdBy": { "type": "string" },
        "lastSent": { "type": "string", "format": "date-time" }
      },
      "required": ["frequency", "recipients", "type"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global application setting",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["key", "value"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Audit trail of field changes and user actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "collection": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string", "enum": ["create", "update", "delete", "bulk_assign", "bulk_upload", "verify"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "oldValue": { "type": "any" },
              "newValue": { "type": "any" }
            }
          }
        }
      },
      "required": ["itemId", "collection", "userId", "userName", "userEmail", "action", "timestamp", "changes"]
    },
    "Resource": {
      "title": "Team Resource",
      "description": "Uploaded document, study, or NABH knowledge resource",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "version": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "string" },
        "fileData": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdByRole": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "updatedByName": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "downloadCount": { "type": "number" }
      },
      "required": ["title", "category", "version", "createdBy", "createdByName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "resources/{resourceId}": {
      "schema": "Resource",
      "description": "Team study documents and knowledge resources"
    },
    "audit_logs/{id}": {
      "schema": "AuditLog",
      "description": "System-wide data change logs"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "hospitals/{hospitalId}": {
      "schema": "Hospital",
      "description": "Hospital records"
    },
    "interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "Communication logs"
    },
    "applications/{applicationId}": {
      "schema": "Application",
      "description": "NABH applications"
    },
    "report_schedules/{scheduleId}": {
      "schema": "ReportSchedule",
      "description": "Email report schedules"
    },
    "settings/{settingId}": {
      "schema": "Setting",
      "description": "System settings like API keys"
    },
    "zones/{zoneId}": {
      "schema": "Zone",
      "description": "Regional zone definitions"
    }
  }
}
